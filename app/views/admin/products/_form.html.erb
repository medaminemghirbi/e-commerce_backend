<div class="max-w-3xl">
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-6">
    <%= form_with model: [:admin, product], class: "space-y-6" do |f| %>
      <% if product.errors.any? %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
          <%= product.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <h3 class="font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">Informations de base</h3>
        <div class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nom (FR) *</label>
              <%= f.text_field :name_fr, required: true, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nom (AR)</label>
              <%= f.text_field :name_ar, dir: "rtl", class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Nom (EN)</label>
              <%= f.text_field :name_en, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Description (FR)</label>
            <%= f.text_area :description_fr, rows: 3, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm resize-none" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Catégorie</label>
            <%= f.collection_select :category_id, @categories, :id, :name_fr, { include_blank: "— Choisir —" }, { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm bg-white" } %>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">Prix & Stock</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Prix d'achat</label>
            <%= f.number_field :purchase_price, step: 0.01, min: 0, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Prix de vente</label>
            <%= f.number_field :selling_price, step: 0.01, min: 0, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Stock</label>
            <%= f.number_field :stock_quantity, min: 0, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
            <%= f.select :status, [["Actif", "active"], ["Inactif", "inactive"]], {}, { class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm bg-white" } %>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">Promotion</h3>
        <div class="flex items-center gap-6">
          <label class="flex items-center gap-3 cursor-pointer">
            <%= f.check_box :has_promotion, class: "w-4 h-4 accent-sky-600" %>
            <span class="text-sm font-medium text-gray-700">Activer la promotion</span>
          </label>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Remise (%)</label>
            <%= f.number_field :promotion_discount, min: 0, max: 100, class: "w-24 px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
          </div>
        </div>
      </div>

      <div>
        <h3 class="font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100">Images (URLs)</h3>
        <% (product.images || []).each_with_index do |img, i| %>
          <div class="flex gap-2 mb-2">
            <input type="text" name="product[images][]" value="<%= img %>" placeholder="https://..."
                   class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
          </div>
        <% end %>
        <input type="text" name="product[images][]" placeholder="Ajouter une URL d'image..."
               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
      </div>

      <div class="flex gap-3 pt-4">
        <%= f.submit product.persisted? ? "Mettre à jour" : "Créer le produit",
            class: "px-8 py-3 bg-sky-600 text-white font-bold rounded-xl hover:bg-sky-700 transition-colors cursor-pointer" %>
        <%= link_to "Annuler", admin_products_path, class: "px-8 py-3 border border-gray-200 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
