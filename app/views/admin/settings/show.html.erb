<% content_for :page_title, "Paramètres" %>
<div class="max-w-lg">
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
    <h2 class="font-bold text-gray-800 text-lg mb-6">💰 Paramètres de tarification</h2>
    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-6" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Marge bénéficiaire (%)</label>
        <input type="number" name="margin" value="<%= @margin %>" min="0" max="100" step="1"
               class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
        <p class="text-xs text-gray-400 mt-1">Appliqué automatiquement à tous les prix de vente</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Remise promotion par défaut (%)</label>
        <input type="number" name="promotion" value="<%= @promotion %>" min="0" max="100" step="1"
               class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
        ⚠️ Sauvegarder recalculera les prix de vente de <strong>tous les produits</strong>.
      </div>
      <button type="submit" class="w-full py-3 bg-sky-600 text-white font-bold rounded-xl hover:bg-sky-700 transition-colors">
        💾 Sauvegarder et recalculer
      </button>
    <% end %>
  </div>
</div>
