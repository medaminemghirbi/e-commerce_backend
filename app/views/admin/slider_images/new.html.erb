<% content_for :page_title, "Nouvelle image" %>
<%= link_to "← Slider", admin_slider_images_path, class: "text-sm text-gray-500 hover:text-sky-600 mb-6 inline-block" %>
<div class="max-w-lg bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
  <%= form_with model: [:admin, @slide], class: "space-y-4" do |f| %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">URL de l'image *</label>
      <%= f.url_field :image_url, required: true, placeholder: "https://...", class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
    </div>
    <div><label class="block text-sm font-medium text-gray-700 mb-1">Titre</label><%= f.text_field :title, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %></div>
    <div><label class="block text-sm font-medium text-gray-700 mb-1">Sous-titre</label><%= f.text_field :subtitle, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %></div>
    <div class="grid grid-cols-2 gap-4">
      <div><label class="block text-sm font-medium text-gray-700 mb-1">Ordre</label><%= f.number_field :sort_order, class: "w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %></div>
      <div class="flex items-end pb-2"><label class="flex items-center gap-2 text-sm font-medium text-gray-700 cursor-pointer"><%= f.check_box :active, class: "w-4 h-4 accent-sky-600" %> Actif</label></div>
    </div>
    <div class="flex gap-3 pt-2">
      <%= f.submit "Ajouter", class: "px-6 py-2.5 bg-sky-600 text-white font-bold rounded-xl hover:bg-sky-700 cursor-pointer" %>
      <%= link_to "Annuler", admin_slider_images_path, class: "px-6 py-2.5 border border-gray-200 text-gray-700 rounded-xl hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
