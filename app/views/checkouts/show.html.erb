<div class="max-w-3xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-8">Finaliser la commande</h1>
  <%= form_with url: checkout_path, method: :post, class: "space-y-6" do |f| %>
    <!-- Guest email -->
    <% unless user_signed_in? %>
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-sm text-amber-800">
        ⚠️ Vous commandez en tant qu'invité. Notez bien votre référence après validation.
      </div>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <h2 class="font-bold text-gray-800 mb-4">Votre email</h2>
        <input type="email" name="order[user_email]" required placeholder="votre@email.com"
               class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
      </div>
    <% else %>
      <input type="hidden" name="order[user_email]" value="<%= current_user.email %>">
    <% end %>

    <!-- Delivery address -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-800 mb-4">📍 Adresse de livraison</h2>
      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nom complet *</label>
            <input type="text" name="order[delivery_address][full_name]" required
                   value="<%= current_user&.full_name %>"
                   class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone *</label>
            <input type="tel" name="order[delivery_address][phone]" required
                   value="<%= current_user&.phone %>"
                   class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Adresse *</label>
          <input type="text" name="order[delivery_address][address]" required
                 class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Ville *</label>
            <input type="text" name="order[delivery_address][city]" required
                   class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Wilaya *</label>
            <input type="text" name="order[delivery_address][wilaya]" required
                   class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Notes (optionnel)</label>
          <textarea name="order[notes]" rows="2"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm resize-none"></textarea>
        </div>
      </div>
    </div>

    <!-- Order summary -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-800 mb-4">📦 Votre commande</h2>
      <div class="space-y-3 mb-4">
        <% cart_items.each do |item| %>
          <div class="flex items-center gap-3 text-sm">
            <div class="w-10 h-10 rounded-lg overflow-hidden bg-gray-50 border border-gray-100 shrink-0">
              <% if item["image"].present? %>
                <img src="<%= item["image"] %>" class="w-full h-full object-cover">
              <% else %>
                <div class="w-full h-full flex items-center justify-center">💊</div>
              <% end %>
            </div>
            <span class="flex-1 text-gray-800 font-medium"><%= item["name_fr"] %></span>
            <span class="text-gray-500">×<%= item["quantity"] %></span>
            <span class="font-bold text-sky-600"><%= number_to_currency(item["unit_price"].to_f * item["quantity"].to_i, unit: "TND", format: "%n %u") %></span>
          </div>
        <% end %>
      </div>
      <div class="border-t border-gray-100 pt-4 space-y-2 text-sm">
        <div class="flex justify-between text-gray-500">
          <span>Sous-total</span><span><%= number_to_currency(cart_total, unit: "TND", format: "%n %u") %></span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Livraison</span>
          <span><%= cart_total >= 100 ? "Gratuite 🎉" : "8.00 TND" %></span>
        </div>
        <div class="flex justify-between font-bold text-base pt-2 border-t border-gray-100">
          <span class="text-gray-800">Total</span>
          <span class="text-sky-600"><%= number_to_currency(cart_total + (cart_total >= 100 ? 0 : 8), unit: "TND", format: "%n %u") %></span>
        </div>
      </div>
    </div>

    <button type="submit" class="w-full py-4 bg-sky-600 text-white font-bold text-lg rounded-2xl hover:bg-sky-700 transition-colors">
      ✅ Confirmer la commande
    </button>
  <% end %>
</div>
