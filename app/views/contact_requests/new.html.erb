<div class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-8">📞 Nous contacter</h1>
  <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-8">
    <%= form_with model: @contact, url: contact_requests_path, class: "space-y-5" do |f| %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Prénom *</label>
          <%= f.text_field :first_name, required: true, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nom *</label>
          <%= f.text_field :last_name, required: true, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
        <%= f.email_field :email, required: true, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
        <%= f.telephone_field :phone, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
      </div>
      <% if @products.any? %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Produit concerné (optionnel)</label>
        <%= f.collection_select :product_id, @products, :id, :name_fr, { include_blank: "— Sélectionner un produit —" }, { class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm bg-white" } %>
      </div>
      <% end %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
        <%= f.text_area :message, required: true, rows: 5, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm resize-none" %>
      </div>
      <%= f.submit "Envoyer le message", class: "w-full py-4 bg-sky-600 text-white font-bold rounded-xl hover:bg-sky-700 transition-colors cursor-pointer" %>
    <% end %>
  </div>
</div>
