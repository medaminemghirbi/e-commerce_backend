<h2 class="text-2xl font-extrabold text-gray-900 mb-6 text-center">Créer un compte</h2>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <% if resource.errors.any? %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700">
      <%= resource.errors.full_messages.join(", ") %>
    </div>
  <% end %>
  <div class="space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Prénom</label>
        <%= f.text_field :first_name, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
        <%= f.text_field :last_name, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
      <%= f.email_field :email, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
      <%= f.telephone_field :phone, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
      <%= f.password_field :password, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Confirmer le mot de passe</label>
      <%= f.password_field :password_confirmation, class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 text-sm" %>
    </div>
    <%= f.submit "Créer mon compte", class: "w-full py-3 bg-sky-600 text-white font-bold rounded-xl hover:bg-sky-700 transition-colors cursor-pointer mt-2" %>
  </div>
<% end %>
<p class="text-center text-sm text-gray-500 mt-6">
  Déjà un compte ?
  <%= link_to "Se connecter", new_user_session_path, class: "font-semibold text-sky-600 hover:underline" %>
</p>
