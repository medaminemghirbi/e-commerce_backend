<h2 class="text-2xl font-extrabold text-gray-900 mb-6 text-center">Connexion</h2>
<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
      <%= f.password_field :password, autocomplete: "current-password",
          class: "w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent text-sm" %>
    </div>
    <div class="flex items-center justify-between">
      <label class="flex items-center gap-2 text-sm text-gray-600">
        <%= f.check_box :remember_me %> Se souvenir de moi
      </label>
      <%= link_to "Mot de passe oublié ?", new_user_password_path, class: "text-sm text-sky-600 hover:underline" %>
    </div>
    <%= f.submit "Se connecter", class: "w-full py-3 bg-sky-600 text-white font-bold rounded-xl hover:bg-sky-700 transition-colors cursor-pointer mt-2" %>
  </div>
<% end %>
<p class="text-center text-sm text-gray-500 mt-6">
  Pas encore de compte ?
  <%= link_to "Créer un compte", new_user_registration_path, class: "font-semibold text-sky-600 hover:underline" %>
</p>
