<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "MedicareInaya" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <!-- Navbar -->
    <nav class="fixed top-0 inset-x-0 z-50 bg-white shadow-sm border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4">

        <!-- Logo -->
        <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
          <div class="flex flex-col leading-none">
            <span class="font-extrabold text-gray-900 text-lg tracking-tight">Medicare</span>
            <span class="text-xs font-semibold text-sky-500 tracking-widest uppercase">by inaya</span>
          </div>
        <% end %>

        <!-- Nav links -->
        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
          <%= link_to "Accueil", root_path, class: "hover:text-sky-600 transition-colors #{request.path == '/' ? 'text-sky-600 font-semibold' : ''}" %>
          <%= link_to "Produits", products_path, class: "hover:text-sky-600 transition-colors #{request.path.start_with?('/products') ? 'text-sky-600 font-semibold' : ''}" %>
          <%= link_to "Contact", new_contact_request_path, class: "hover:text-sky-600 transition-colors #{request.path.start_with?('/contact') ? 'text-sky-600 font-semibold' : ''}" %>
        </div>

        <!-- Right actions -->
        <div class="flex items-center gap-2">
          <!-- Language indicator -->
          <span class="hidden md:flex items-center gap-1.5 text-sm font-medium text-gray-600 px-2 py-1.5 rounded-lg hover:bg-gray-50 cursor-default">
            🇫🇷 <span>FR</span>
            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </span>

          <!-- Cart -->
          <%= link_to cart_path, class: "relative p-2 rounded-xl hover:bg-gray-100 transition-colors" do %>
            <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.5 19m1.5 0h9m-9 0a1 1 0 100 2 1 1 0 000-2zm9 0a1 1 0 100 2 1 1 0 000-2z"/>
            </svg>
            <% if cart_count > 0 %>
              <span class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-xs font-bold rounded-full w-4 h-4 flex items-center justify-center leading-none"><%= cart_count %></span>
            <% end %>
          <% end %>

          <% if user_signed_in? %>
            <div class="flex items-center gap-2 ml-1">
              <% if current_user.admin? %>
                <%= link_to "Admin", admin_root_path, class: "text-sm font-semibold px-3 py-1.5 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors" %>
              <% else %>
                <%= link_to "Mes commandes", client_orders_path, class: "text-sm font-medium text-gray-600 hover:text-sky-600 px-3 py-1.5 rounded-lg hover:bg-gray-50" %>
              <% end %>
              <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-gray-500 hover:text-red-500 px-2 py-1.5" %>
            </div>
          <% else %>
            <%= link_to "Connexion", new_user_session_path, class: "ml-1 text-sm font-semibold px-4 py-2 bg-sky-600 text-white rounded-lg hover:bg-sky-700 transition-colors" %>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Flash -->
    <div class="fixed top-20 right-4 z-50 space-y-2 max-w-sm">
      <% flash.each do |type, msg| %>
        <div class="px-4 py-3 rounded-xl text-sm font-medium shadow-lg border <%= type == 'notice' ? 'bg-green-50 text-green-800 border-green-200' : 'bg-red-50 text-red-800 border-red-200' %>">
          <%= msg %>
        </div>
      <% end %>
    </div>

    <main class="flex-1 pt-16">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-100 py-12 mt-8">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <!-- Brand -->
          <div>
            <div class="flex items-center gap-2 mb-3">
              <div class="flex flex-col leading-none">
                <span class="font-extrabold text-gray-900 text-lg">Medicare</span>
                <span class="text-xs font-semibold text-sky-500 tracking-widest uppercase">by inaya</span>
              </div>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed max-w-xs">Votre partenaire de confiance pour les produits paramédicaux de qualité en Tunisie.</p>
          </div>
          <!-- Navigation -->
          <div>
            <h4 class="text-xs font-bold text-gray-900 uppercase tracking-widest mb-4">Navigation</h4>
            <ul class="space-y-2 text-sm text-gray-500">
              <li><%= link_to "Accueil", root_path, class: "hover:text-sky-600 transition-colors" %></li>
              <li><%= link_to "Produits", products_path, class: "hover:text-sky-600 transition-colors" %></li>
              <li><%= link_to "Contact", new_contact_request_path, class: "hover:text-sky-600 transition-colors" %></li>
            </ul>
          </div>
          <!-- Contact -->
          <div>
            <h4 class="text-xs font-bold text-gray-900 uppercase tracking-widest mb-4">Contact</h4>
            <ul class="space-y-2 text-sm text-gray-500">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                contact@medicareinaya.tn
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                +216 XX XXX XXX
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Tunisie
              </li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-100 pt-6 flex items-center justify-between text-sm text-gray-400">
          <p>© <%= Time.current.year %> MedicareInaya. Tous droits réservés.</p>
          <%= link_to "Contact", new_contact_request_path, class: "hover:text-sky-600 transition-colors" %>
        </div>
      </div>
    </footer>
  </body>
</html>
